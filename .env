BGE_M3=BAAI/bge-m3
# gpu
#BGE_DEVICE=cuda:0
# cpu 
 BGE_DEVICE=cpu
# cpu 需要关闭 0  GPU 上生成向量通常默认开启了半精度浮点数（FP16）加速，而 CPU 上通常使用单精度（FP32）
BGE_FP16=0
ITEM_NAME_DIAG=1

# Milvus 配置
# 切换成你milvus的url地址
